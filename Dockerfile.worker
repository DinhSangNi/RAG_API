FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy requirements
COPY requirements-worker.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-worker.txt \
    && rm -rf ~/.cache/pip

# Copy application code
COPY . .

# Ensure shared storage directory exists with proper permissions
# This may be overridden by Volume mounts, so use -p to not fail if it exists
RUN mkdir -p /app/data && chmod -R 777 /app/data || true

# Set Python to run in unbuffered mode (forces log output immediately to Azure)
ENV PYTHONUNBUFFERED=1

# Set a non-root user for security (optional but recommended)
# RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
# USER appuser

# Run worker with -u flag to ensure logs flush to stdout immediately
# This is critical for Azure Container Instances to see logs in real-time
CMD ["python", "-u", "worker.py"]

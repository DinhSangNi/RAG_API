# Copy this file to .env and fill in your actual values
# Do NOT commit .env to git repository

# ============================================================
# Application Configuration
# ============================================================

# Application Info (optional)
APP_NAME=RAG Service
APP_VERSION=1.0.0
DEBUG=False

# ============================================================
# Database Configuration
# ============================================================
# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# ============================================================
# Google Gemini AI Configuration
# ============================================================
# Required: Get from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# ============================================================
# Embedding Model Configuration
# ============================================================
# Embedding model and dimension (for pgvector)
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
DIMENSION_OF_MODEL=768

# ============================================================
# Redis Queue Configuration
# ============================================================
# For local development: use 'localhost' or '127.0.0.1'
# For Docker: use 'redis' (service name)
# For Azure: use your Redis cache endpoint
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Optional: Redis password (if using Azure Cache for Redis)
# REDIS_PASSWORD=your-redis-password

# ============================================================
# Cloudinary Configuration (File Storage)
# ============================================================
# Required: Get from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=rag_documents

# ============================================================
# File Storage Configuration
# ============================================================
# Directories for data storage (local paths)
TEMP_UPLOAD_DIR=./data/temp_uploads
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
RAW_DIR=./data/raw

# ============================================================
# Retrieval Configuration
# ============================================================
# Minimum similarity threshold for summary relevance
SUMMARY_RELEVANCE_THRESHOLD=0.67

# ============================================================
# Chunking Configuration
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ============================================================
# Queue Configuration
# ============================================================
QUEUE_NAME=rag_indexing


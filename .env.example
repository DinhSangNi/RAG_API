# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
DIMENSION_OF_MODEL=768

# Database (Remote PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/ragdb

# Cloudinary Configuration
# Get these values from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Shared Storage Configuration (used by both API and Worker)
# Local development: ./site
# Azure App Service: /home/site (automatically detected in Docker)
# This path is used for temporary files exchanged between API and Worker
WEBAPP_STORAGE_HOME=./site

# Redis Configuration (for background task queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
